      "layoutMode": "VERTICAL",
      "itemSpacing": 12,
      "paddingTop": 20,
      "paddingBottom": 20,
      "paddingLeft": 20,
      "paddingRight": 20,
      "cornerRadius": 12,
      "layoutSizingHorizontal": "FIXED",
      "width": 280,
      "fills": [
        {
          "type": "SOLID",
          "color": { "r": 1, "g": 1, "b": 1 }
        }
      ],
      "effects": [
        {
          "type": "DROP_SHADOW",
          "visible": true,
